DATABASE_URL=postgresql://user:password@localhost:5433/servicio_tecnico
# Separate database used by `npm run test:e2e` (migrated automatically).
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/servicio_tecnico_test
JWT_SECRET=replace-with-a-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
LABOR_HOURLY_RATE=80
# Days a technical budget stays valid before it expires (Budgets module).
BUDGET_VALIDITY_DAYS=7
# 32-byte hex key (64 chars) for AES-256-GCM encryption of device unlock codes.
UNLOCK_CODE_ENCRYPTION_KEY=replace-with-64-hex-chars
# Comma-separated CORS allowlist, e.g. CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=

# Seed demo passwords (DB-E07): per-role overrides, or one shared default.
# Required to run `npm run prisma:seed`. Never hardcoded in the seed script.
SEED_PASSWORD=replace-with-a-seed-password
# Optional per-role overrides:
SEED_PASSWORD_RECEPTIONIST=
SEED_PASSWORD_TECHNICIAN=
SEED_PASSWORD_CUSTOMER=
SEED_PASSWORD_ADMIN=

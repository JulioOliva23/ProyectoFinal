{
  "name": "taller-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP del servicio técnico: expone órdenes, auditoría, stock y propuestas de transición con aprobación humana.",
  "type": "module",
  "bin": { "taller-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.0"
  },
  "engines": { "node": ">=24" }
}
